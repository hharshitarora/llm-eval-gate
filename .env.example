# Only needed for `--adapter triage` (live runs) and `--judge llm`.
# The default hermetic path (`--adapter mock --judge heuristic`) needs nothing.
OPENAI_API_KEY=sk-...

# Model used by the LLM judge. Cheap on purpose: the judge is graded too.
EVALGATE_JUDGE_MODEL=gpt-4o-mini

# Path to a local checkout of the system under test.
TRIAGE_REPO_PATH=../incident-triage-agent
